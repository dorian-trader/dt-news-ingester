ALPHA_VANTAGE_API_KEY=your_key_here
# Max articles per request (1–1000)
ALPHA_VANTAGE_LIMIT=50

# SQLite path (directory is created if needed).
# Local npm: ./data/news.db is fine.
# Docker: do NOT use ./data/... in an env file you pass with --env-file — it resolves to
# /app/data inside the container, not the /data volume. Omit SQLITE_PATH so the image
# default (/data/news.db) applies, or set SQLITE_PATH=/data/news.db for Docker.
SQLITE_PATH=./data/news.db
# SQLite journal mode (WAL or DELETE). WAL is best for local concurrency.
# On Windows bind mounts in Docker Desktop, WAL can fail with SQLITE_IOERR_SHMOPEN;
# use DELETE there if needed.
SQLITE_JOURNAL_MODE=WAL

# ----------------------------
# Backfill (run with `npm run backfill`)
# ----------------------------
# Alpha Vantage NEWS_SENTIMENT `time_from` / `time_to` are minute precision: YYYYMMDDTHHMM (UTC).
# Backfill window (UTC). Defaults match “backfill from Jan 1 2025 up to the start time”.
BACKFILL_LOWER_BOUND=2025-01-01T00:00:00.000Z
BACKFILL_UPPER_BOUND=2026-03-25T20:09:13.000Z

# Chunk the window into coarse intervals, then recursively split any chunk that hits ALPHA_VANTAGE_LIMIT.
# Larger chunks => fewer requests, but deeper splitting if the chunk is dense.
BACKFILL_CHUNK_SECONDS=86400

# How many seconds to overlap adjacent chunks (inclusive endpoints).
# Use 1 as a safety buffer against boundary handling differences.
BACKFILL_OVERLAP_SECONDS=1

# Minimum interval granularity (seconds) when splitting by time.
# If a split cannot go smaller and still hits ALPHA_VANTAGE_LIMIT, the backfill stops with a “completeness” error (raise limit up to 1000).
# Exception: when time_from/time_to map to a single API minute, the backfill stores up to ALPHA_VANTAGE_LIMIT rows and continues (possible truncation).
BACKFILL_MIN_INTERVAL_SECONDS=1

# Retry behavior for transient Alpha Vantage failures.
BACKFILL_MAX_RETRIES=5
BACKFILL_RETRY_BASE_DELAY_MS=5000
BACKFILL_RETRY_MAX_DELAY_MS=60000

# Global Alpha Vantage request pacing (applies to every NEWS_SENTIMENT call, including splits and retries).
# Default ~50 requests/min (~1200ms between starts). Values above 75 are capped at 75 when deriving delay from RPM.
# Override spacing exactly with BACKFILL_MIN_MS_BETWEEN_REQUESTS (e.g. 1100 for ~54/min). Set to 0 to disable pacing.
# To disable via RPM instead: BACKFILL_MAX_REQUESTS_PER_MINUTE=0 (only if BACKFILL_MIN_MS_BETWEEN_REQUESTS is unset).
BACKFILL_MAX_REQUESTS_PER_MINUTE=50
# BACKFILL_MIN_MS_BETWEEN_REQUESTS=1200

# Optional delay between successful interval fetches (milliseconds).
# Set to something like 200–1000 if you still see transient Alpha Vantage “Note” responses.
BACKFILL_BETWEEN_INTERVALS_DELAY_MS=0

# Name/path of the env file to load for `npm run backfill`.
# The backfill runner defaults to `<projectRoot>/.env.backfill`.
# Set this if you want a different filename/location, e.g. `BACKFILL_ENV_FILE=.env.backfill.production`.
BACKFILL_ENV_FILE=.env.backfill
