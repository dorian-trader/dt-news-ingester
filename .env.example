ALPHA_VANTAGE_API_KEY=your_key_here
# Max articles per request (1–1000)
ALPHA_VANTAGE_LIMIT=50

# SQLite path (directory is created if needed).
# Local npm: ./data/news.db is fine.
# Docker: do NOT use ./data/... in an env file you pass with --env-file — it resolves to
# /app/data inside the container, not the /data volume. Omit SQLITE_PATH so the image
# default (/data/news.db) applies, or set SQLITE_PATH=/data/news.db for Docker.
SQLITE_PATH=./data/news.db
