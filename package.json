{
  "name": "dt-news-ingester",
  "version": "1.0.0",
  "private": true,
  "description": "Periodically ingest Alpha Vantage news sentiment into SQLite",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "ingest-once": "node scripts/ingest-once.mjs",
    "dev": "tsx watch src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
